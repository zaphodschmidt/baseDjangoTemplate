/.env
/.env.*
!/.env.template

# Database archives. Every one is a complete copy of a database, some of them
# production. They are written 0600 and they never go in git.
/backups/

# collectstatic output. The directory is tracked (WhiteNoise warns without it);
# its contents are build artifacts.
/backend/static/*
!/backend/static/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/
dist/

# Editors / OS
.DS_Store
*.swp
