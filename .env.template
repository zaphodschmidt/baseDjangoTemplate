# Copy to .env and fill in. .env is git-ignored; this file is committed with
# every key present and no real value, so a missing variable is a diff rather
# than a discovery at boot.

# ── Django ─────────────────────────────────────────────────────────────────
# Required when DEBUG is false; the app refuses to boot without it. Generate:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
SECRET_KEY=

# false everywhere except a machine no DNS record points at. Settings refuse to
# start with DEBUG on alongside a routable DJANGO_ALLOWED_HOSTS.
DEBUG=true

# Comma-separated. Empty + DEBUG=false means Django answers 400 to everything,
# which is the correct failure: an unset variable must never become '*'.
DJANGO_ALLOWED_HOSTS=

# Comma-separated, scheme included, e.g. https://example.com. Needed only once
# the app is served over a hostname.
CSRF_TRUSTED_ORIGINS=

LOG_LEVEL=INFO
PROJECT_TITLE=API

# ── Database ───────────────────────────────────────────────────────────────
# NOTE: Postgres applies POSTGRES_PASSWORD only when it initialises an EMPTY
# data directory. Changing DB_PASSWORD here after the volume exists changes
# what the backend presents and not what the database expects — rotate with
# `ALTER USER` inside Postgres instead.
DB_NAME=app
DB_USER=app
DB_PASSWORD=
DB_HOST=db

# ── Host ports (all bound to 127.0.0.1 in compose) ─────────────────────────
# Any host port is a shared resource on a box running several stacks, and the
# obvious default is the most likely to be taken. Check first:
#   docker ps --format '{{.Ports}}'
DB_PORT=5436
BACKEND_PORT=8002
FRONTEND_PORT=3003
DOZZLE_PORT=5052

# Production only: the public port nginx listens on.
HTTP_PORT=80

# ── Frontend ───────────────────────────────────────────────────────────────
# Anything VITE_-prefixed is inlined into the bundle and ships to every
# visitor. Never put a secret here.
# Empty means same-origin — the browser calls /api/... on whatever host served
# the page. Set it only if the API genuinely lives elsewhere.
VITE_API_BASE_URL=
