# ---------------------------------------------------------------------------
# tools/project.env — the ONLY file you edit to point tools/ at a new project.
#
# Every script in tools/ is project-agnostic. The names that differ between one
# repo and the next — the compose files, the service names, the ssh aliases,
# the backup filename prefix — are all here, in one file, so porting the whole
# toolset to a new repo is one edit rather than fourteen.
#
# Sourced by tools/lib/common.sh before anything else. Every value below can be
# overridden per-invocation by exporting the same name in the environment.
# ---------------------------------------------------------------------------

# ── Identity ───────────────────────────────────────────────────────────────
# PROJECT_NAME appears in banners. BACKUP_PREFIX is the first field of every
# archive filename (<prefix>_<target>_<label>_<timestamp>.dump) and of the
# crontab fence, so changing it after backups exist orphans the old ones —
# rename the files too, or leave it alone.
PROJECT_NAME="${PROJECT_NAME:-baseDjangoTemplate}"
BACKUP_PREFIX="${BACKUP_PREFIX:-app}"

# ── Compose files ──────────────────────────────────────────────────────────
# COMPOSE_LOCAL is what runs on a dev box. COMPOSE_PROD is what runs on a
# server; it does not exist in this template, and every remote-target script
# refuses to run until you create it. That refusal is deliberate: a deploy
# script that guesses at your production topology is worse than one that stops.
COMPOSE_LOCAL="${COMPOSE_LOCAL:-docker-compose.yml}"
COMPOSE_PROD="${COMPOSE_PROD:-docker-compose.prod.yml}"

# ── Service names, as compose knows them ───────────────────────────────────
DB_SERVICE="${DB_SERVICE:-db}"
BACKEND_SERVICE="${BACKEND_SERVICE:-backend}"
FRONTEND_SERVICE="${FRONTEND_SERVICE:-frontend}"
# The background worker (django-q / celery). Empty until you add one.
WORKER_SERVICE="${WORKER_SERVICE:-}"

# Services stopped before a restore and started again after it — everything
# that writes the database. Listing a service that does not exist is harmless;
# omitting one that writes is not.
APP_SERVICES_LOCAL="${APP_SERVICES_LOCAL:-backend frontend}"
APP_SERVICES_PROD="${APP_SERVICES_PROD:-backend}"
# Services a deploy waits to see 'running' before it calls itself successful.
DEPLOY_EXPECT_SERVICES="${DEPLOY_EXPECT_SERVICES:-backend}"

# ── Source directories ─────────────────────────────────────────────────────
BACKEND_DIR="${BACKEND_DIR:-backend}"
FRONTEND_DIR="${FRONTEND_DIR:-frontend}"
# The frontend package manager. `make`/verify use it for typecheck and codegen.
PKG_MANAGER="${PKG_MANAGER:-pnpm}"

# ── .env keys this project uses ────────────────────────────────────────────
# Django-startproject repos usually say DB_NAME/DB_USER; docker-postgres repos
# usually say POSTGRES_DB/POSTGRES_USER. Name yours, and the tools read it.
ENV_KEY_DB_NAME="${ENV_KEY_DB_NAME:-DB_NAME}"
ENV_KEY_DB_USER="${ENV_KEY_DB_USER:-DB_USER}"
ENV_KEY_BACKEND_PORT="${ENV_KEY_BACKEND_PORT:-BACKEND_PORT}"
ENV_KEY_ALLOWED_HOSTS="${ENV_KEY_ALLOWED_HOSTS:-DJANGO_ALLOWED_HOSTS}"
DEFAULT_BACKEND_PORT="${DEFAULT_BACKEND_PORT:-8000}"

# ── Health ─────────────────────────────────────────────────────────────────
# Polled after a deploy and before the API codegen. It must be unauthenticated
# and it must touch the database, or it reports a process that is up and an app
# that cannot serve. See backend/defaultApp/views.py:health.
HEALTH_PATH="${HEALTH_PATH:-/api/health/}"

# ── Servers ────────────────────────────────────────────────────────────────
# ssh aliases from ~/.ssh/config, not hostnames — the config is where the key,
# user and port live, and cron has no agent to fall back on.
PROD_SSH="${PROD_SSH:-prod-app}"
TEST_SSH="${TEST_SSH:-test-app}"
# Where the checkout lives on those boxes.
REMOTE_REPO_DIR="${REMOTE_REPO_DIR:-~/app}"
# The env file the remote compose is invoked with.
REMOTE_ENV_FILE="${REMOTE_ENV_FILE:-.env}"
# Peer-auth superuser on the server's host Postgres. No password is involved.
PG_SUPERUSER="${PG_SUPERUSER:-postgres}"
